### GET companies
GET {{baseUrl}}/companies
Authorization: Bearer {{accessToken}}

### POST create company A
POST {{baseUrl}}/companies
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Alpha GmbH",
  "street": "Hauptstrasse 12",
  "city": "Essen",
  "zip": "45127",
  "website": "https://alpha.example.com",
  "notes": "Test company A"
}

### POST create company B
POST {{baseUrl}}/companies
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Beta AG",
  "street": "Bahnhofstrasse 8",
  "city": "Dortmund",
  "zip": "44135",
  "website": "https://beta.example.com",
  "notes": "Test company B"
}

### GET company A by id
GET {{baseUrl}}/companies/{{companyAId}}
Authorization: Bearer {{accessToken}}

### PATCH company A
PATCH {{baseUrl}}/companies/{{companyAId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "notes": "Updated notes for Alpha GmbH"
}

### DELETE company B
DELETE {{baseUrl}}/companies/{{companyBId}}
Authorization: Bearer {{accessToken}}



### GET contacts
GET {{baseUrl}}/contacts
Authorization: Bearer {{accessToken}}

### POST create contact A1
POST {{baseUrl}}/contacts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Max Müller",
  "email": "max.mueller@alpha.example.com",
  "phone": "+49 201 123456",
  "company": "{{companyAId}}",
  "linkedIn": "https://www.linkedin.com/in/max-mueller-alpha"
}

